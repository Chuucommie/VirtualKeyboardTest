@page "/"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Virtual Keyboard Demo</PageTitle>

<div style="padding: 24px; max-width: 800px; margin: 0 auto;">

    <FluentStack Orientation="Orientation.Vertical" HorizontalGap="20" Style="width: 100%;">

        <h2>Virtual Keyboard API Demo</h2>

        <FluentCard Style="padding: 20px;">
            <FluentStack Orientation="Orientation.Vertical" HorizontalGap="12">
                <h4>Standard Field</h4>
                <FluentTextInput @bind-Value="standardValue"
                                 Placeholder="Tap to type..."
                                 Style="width: 100%;" />
            </FluentStack>
        </FluentCard>

        <FluentCard Style="padding: 20px; border: 2px solid var(--accent-fill-rest);">
            <FluentStack Orientation="Orientation.Vertical" HorizontalGap="12">
                <h4>Hidden Keyboard Field</h4>
                <FluentStack Orientation="Orientation.Horizontal" VerticalGap="8" Style="align-items: flex-end;">
                    <FluentTextInput @bind-Value="manualValue"
                                     Id="manual-input"
                                     Placeholder="Keyboard stays hidden..."
                                     AdditionalAttributes="manualKeyboardAttrs"
                                     Style="flex: 1;" />
                    <FluentButton ButtonAppearance="ButtonAppearance.Default"
                                  OnClick="ClearInput"
                                  Title="Cancella contenuto">✖</FluentButton>
                    <FluentButton ButtonAppearance="ButtonAppearance.Primary"
                                  OnClick="ShowKeyboard"
                                  Title="Mostra tastiera">⌨</FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentCard>

    </FluentStack>

</div>

@code {
    private string standardValue = "";
    private string manualValue = "";

    private Dictionary<string, object> manualKeyboardAttrs = new()
    {
        { "virtualkeyboardpolicy", "manual" }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initVirtualKeyboard");
        }
    }

    private async Task ClearInput()
    {
        await JS.InvokeVoidAsync("clearManualInput");
        manualValue = "";
    }

    private async Task ShowKeyboard()
    {
        await JS.InvokeVoidAsync("showVirtualKeyboard");
    }

    public async ValueTask DisposeAsync()
    {
    }
}