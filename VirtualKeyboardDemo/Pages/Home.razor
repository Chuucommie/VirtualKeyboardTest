@page "/"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Virtual Keyboard Demo</PageTitle>

<div class="container mt-4">
    <h2>Virtual Keyboard API Demo</h2>
    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card p-3 bg-light">
                <h4>Standard Fields</h4>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Tap to type..." />
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card p-3 border-primary">
                <h4>Hidden Keyboard Fields</h4>
                <div class="input-group mb-3">
                    <input type="text"
                           @ref="manualInput"
                           id="manual-input"
                           class="form-control border-primary"
                           virtualkeyboardpolicy="manual"
                           placeholder="Keyboard stays hidden..." />
                    <button class="btn btn-outline-danger"
                            type="button"
                            title="Cancella contenuto"
                            @onclick="ClearInput">
                        ✖
                    </button>
                    <button class="btn btn-outline-success"
                            type="button"
                            title="Mostra tastiera"
                            @onclick="ShowKeyboard">
                        ⌨
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IJSObjectReference? module;
    private ElementReference manualInput;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./virtualKeyboard.js");
            await module.InvokeVoidAsync("initVirtualKeyboard");
        }
    }

    private async Task ClearInput()
    {
        await module!.InvokeVoidAsync("clearInput", manualInput);
    }

    private async Task ShowKeyboard()
    {
        await module!.InvokeVoidAsync("showKeyboard", manualInput);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null) await module.DisposeAsync();
    }
}