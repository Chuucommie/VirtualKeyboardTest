@inherits LayoutComponentBase
@implements IDisposable

<div style="position: relative; min-height: 100vh; padding-bottom: 72px; overflow-y: auto; -webkit-overflow-scrolling: touch;">
    <main>
        <article class="content px-4" style="padding-top: 1rem; max-width: 900px; margin: 0 auto;">
            @Body
        </article>
    </main>
</div>

<!-- Floating bottom navigation bar -->
<nav class="floating-nav">
    <button class="nav-btn @(CurrentPage == "home" ? "active" : "")" @onclick='() => Nav.NavigateTo("")'>
        <span class="nav-icon">🏠</span>
        <span class="nav-label">Home</span>
    </button>
    <button class="nav-btn @(CurrentPage == "customer" ? "active" : "")" @onclick='() => Nav.NavigateTo("customer")'>
        <span class="nav-icon">👤</span>
        <span class="nav-label">Customer</span>
    </button>
    <button class="nav-btn @(CurrentPage == "billing" ? "active" : "")" @onclick='() => Nav.NavigateTo("billing")'>
        <span class="nav-icon">🧾</span>
        <span class="nav-label">Billing</span>
    </button>
    <button class="nav-btn @(CurrentPage == "inventory" ? "active" : "")" @onclick='() => Nav.NavigateTo("inventory")'>
        <span class="nav-icon">📦</span>
        <span class="nav-label">Inventory</span>
    </button>
    <button class="nav-btn @(CurrentPage == "feedback" ? "active" : "")" @onclick='() => Nav.NavigateTo("feedback")'>
        <span class="nav-icon">💬</span>
        <span class="nav-label">Feedback</span>
    </button>
</nav>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    private string CurrentPage = "home";

    protected override void OnInitialized()
    {
        UpdateCurrentPage();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateCurrentPage();
        StateHasChanged();
    }

    private void UpdateCurrentPage()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri);
        var path = uri.Split('?')[0].Split('#')[0].Trim('/');
        CurrentPage = string.IsNullOrEmpty(path) ? "home" : path;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}