@inherits LayoutComponentBase

<div class="page">
    <div style="background: var(--neutral-layer-2, #f0f0f0); border-bottom: 1px solid var(--neutral-stroke-rest, #d1d1d1); padding: 0 16px;">
        <div style="max-width: 900px; margin: 0 auto; display: flex; gap: 0; overflow-x: auto;">
            <a href="" style="padding: 12px 16px; text-decoration: none; color: var(--neutral-foreground-rest, #242424); font-weight: 600; font-size: 14px; border-bottom: 2px solid transparent; white-space: nowrap;">🏠 Home</a>
            <a href="customer" style="padding: 12px 16px; text-decoration: none; color: var(--neutral-foreground-rest, #242424); font-weight: 500; font-size: 14px; border-bottom: 2px solid transparent; white-space: nowrap;">👤 Customer</a>
            <a href="billing" style="padding: 12px 16px; text-decoration: none; color: var(--neutral-foreground-rest, #242424); font-weight: 500; font-size: 14px; border-bottom: 2px solid transparent; white-space: nowrap;">🧾 Billing</a>
            <a href="inventory" style="padding: 12px 16px; text-decoration: none; color: var(--neutral-foreground-rest, #242424); font-weight: 500; font-size: 14px; border-bottom: 2px solid transparent; white-space: nowrap;">📦 Inventory</a>
            <a href="feedback" style="padding: 12px 16px; text-decoration: none; color: var(--neutral-foreground-rest, #242424); font-weight: 500; font-size: 14px; border-bottom: 2px solid transparent; white-space: nowrap;">💬 Feedback</a>
        </div>
    </div>
    <main>
        <article class="content px-4" style="padding-top: 1rem; max-width: 900px; margin: 0 auto;">
            @Body
        </article>
    </main>
</div>